<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gemini & Google Assistant App Action Capability -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="yt.dsh.barq_wear.MainActivity"
            android:targetPackage="yt.dsh.barq_wear">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <!-- 1. Nearby Screen -->
    <shortcut
        android:shortcutId="shortcut_nearby"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher_round"
        android:shortcutShortLabel="@string/shortcut_nearby_short"
        android:shortcutLongLabel="@string/shortcut_nearby_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="barq://nearby"
            android:targetClass="yt.dsh.barq_wear.MainActivity"
            android:targetPackage="yt.dsh.barq_wear">
            <extra
                android:name="feature"
                android:value="nearby" />
        </intent>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/feature_nearby_synonyms" />
        </capability-binding>
    </shortcut>

